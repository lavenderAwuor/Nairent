NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/nairent
JWT_SECRET=replace-this-with-a-long-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=listing-photos
EMAIL_VERIFICATION_ORIGIN=http://localhost:5173
# Set these to a real SMTP provider to deliver confirmation, reservation, and listing-alert emails.
# SMTP_FROM must be a sender address verified by that provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=verify@example.com
